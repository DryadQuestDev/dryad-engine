{
  "id": "experience",
  "name": "Experience",
  "description": "XP and leveling system. Characters with a 'level' trait gain XP and level up automatically.",
  "author": "Nekon",
  "version": "1.0.0",
  "order": -1,
  "scripts": [
    "main.mjs"
  ],
  "tabs": [
    {
      "id": "config_experience",
      "name": "Experience Config",
      "schema": {
        "xp_base": {
          "type": "number",
          "defaultValue": 100,
          "tooltip": "XP threshold to level up at level 1."
        },
        "xp_formula": {
          "type": "chooseOne",
          "options": [
            "linear_percent",
            "exponential_percent",
            "quadratic",
            "cubic",
            "custom_table"
          ],
          "defaultValue": "exponential_percent",
          "tooltip": "How XP threshold scales per level. See the docs for specific formulas."
        },
        "xp_growth": {
          "type": "number",
          "defaultValue": 50,
          "tooltip": "Growth percentage applied per level to the XP threshold.",
          "show": {
            "xp_formula": [
              "linear_percent",
              "exponential_percent"
            ]
          }
        },
        "xp_table": {
          "type": "number[]",
          "tooltip": "Custom XP thresholds per level (index 0 = level 1). Levels beyond the table use the last entry.",
          "show": {
            "xp_formula": [
              "custom_table"
            ]
          }
        },
        "max_level": {
          "type": "number",
          "defaultValue": 99,
          "tooltip": "Maximum character level."
        },
        "level_up_rewards": {
          "type": "schema[]",
          "tooltip": "Currency items (e.g., ability points) awarded to the character's private inventory on each level up. Only items with 'is_currency' enabled appear.",
          "objects": {
            "item_id": {
              "type": "chooseOne",
              "fromFile": "item_templates",
              "fromFileTypeAnd": {
                "is_currency": true
              },
              "required": true,
              "tooltip": "Currency item to award (e.g., skill points)."
            },
            "amount": {
              "type": "number",
              "defaultValue": 1,
              "tooltip": "Quantity per level up."
            }
          }
        }
      }
    }
  ],
  "data": {
    "character_stats": [
      {
        "id": "xp",
        "name": "XP",
        "description": "Experience points toward next level.",
        "is_resource": true,
        "is_hidden": true,
        "can_overflow": true,
        "color": "f0c040",
        "uid": "xp_stat_xp"
      }
    ],
    "character_traits": [
      {
        "id": "level",
        "type": "number",
        "tooltip": "Character's current level. Set in character template to enable XP/leveling.",
        "uid": "xp_trait_level"
      },
      {
        "id": "level_up_status",
        "type": "chooseOne",
        "fromFile": "character_statuses",
        "tooltip": "Status to apply on each level up. Stacks automatically — each level adds one stack. Use for stat growth per level.",
        "uid": "xp_trait_level_up_status"
      },
      {
        "id": "xp_multiplier",
        "type": "number",
        "tooltip": "XP gain multiplier. 1 = normal, 1.5 = 50% bonus, 0.5 = half XP. Leave unset for default (1). Can be modified by statuses/items.",
        "uid": "xp_trait_xp_multiplier"
      }
    ],
    "locale": [
      {
        "id": "xp_level_up",
        "val": "|name| has reached level |level|!"
      },
      {
        "id": "xp_label_level",
        "val": "Lv."
      },
      {
        "id": "xp_label_xp",
        "val": "XP"
      },
      {
        "id": "xp_flash",
        "val": "|name| has earned |amount| XP"
      }
    ]
  }
}