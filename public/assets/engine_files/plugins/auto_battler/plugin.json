{
  "id": "auto_battler",
  "name": "Auto Battler",
  "description": "Auto Battle Grid System",
  "author": "Nekon",
  "version": "1.0.1",
  "order": -10,
  "asset_folders": [],
  "scripts": [
    "main.mjs"
  ],
  "tabs": [
    {
      "uid": "6meGu3HUucPO",
      "id": "battle_config",
      "name": "Config",
      "schema": {
        "rows_size": {
          "type": "number",
          "tooltip": "The breadth of the battlefield, how many character can fit in a single column."
        },
        "columns_size": {
          "tooltip": "The depth of the battlefield(mostly used for ranged attacks).",
          "type": "number"
        },
        "formation_stat_tags": {
          "type": "string[]",
          "tooltip": "Stat tags to display in the formation panel (e.g. battle). Each tag is looked up via locale for the group display name."
        },
        "turn_speed": {
          "type": "number",
          "tooltip": "Virtual turn clock speed. Controls how fast rounds pass for cooldown/status ticking. Higher = faster rounds. Default: 50."
        },
        "mult_floor": {
          "type": "number",
          "tooltip": "Min multiplier floor for % modifiers (damage_dealt_mult, speed_mult). Default: 0.1 (10%)."
        },
        "starting_leader_id": {
          "type": "string",
          "tooltip": "Character ID to use as leader at game start. Their leadership stat defines the formation budget."
        },
        "retreat": {
          "type": "chooseOne",
          "options": [
            "enabled",
            "disabled"
          ],
          "tooltip": "Default retreat behavior for battles. Can be overridden per battle via noRetreat param. Default: enabled."
        }
      }
    },
    {
      "id": "token_definitions",
      "name": "Token Definitions",
      "isArray": true,
      "schema": {
        "id": {
          "type": "string",
          "required": true,
          "tooltip": "Unique token identifier (e.g. 'burn', 'shield', 'berserker')"
        },
        "source": {
          "type": "chooseOne",
          "fromFile": "character_stats",
          "tooltip": "Character stat that sets initial stacks at battle start. Empty = starts at 0."
        },
        "name": {
          "type": "string",
          "required": true,
          "tooltip": "Display name shown in UI"
        },
        "description": {
          "type": "htmlarea",
          "tooltip": "Description shown on hover in character viewer"
        },
        "icon": {
          "type": "file",
          "fileType": "image",
          "tooltip": "Icon displayed on character"
        },
        "color": {
          "type": "color",
          "tooltip": "Color for floating combat text (hex). Overrides default purple."
        },
        "max_stacks": {
          "type": "number",
          "defaultValue": 0,
          "tooltip": "Maximum stacks allowed. 0 = unlimited."
        },
        "polarity": {
          "type": "chooseOne",
          "options": [
            "positive",
            "negative",
            "neutral"
          ],
          "defaultValue": "neutral",
          "tooltip": "positive = buff (cleansable by enemies), negative = debuff (cleansable by allies), neutral = non-cleansable"
        },
        "power_scaling": {
          "type": "boolean",
          "tooltip": "When true, applied stacks scale with caster power: stacks = round(power × aspectStacks / 100). Use for damage/healing tokens (shield, DoT, HoT). Leave false for gating tokens (preparation, combo)."
        },
        "effects": {
          "type": "schema[]",
          "tooltip": "Composable effects that define token behavior",
          "objects": {
            "type": {
              "type": "chooseOne",
              "required": true,
              "options": [
                "dot",
                "hot",
                "absorb",
                "death_defiance",
                "stun"
              ],
              "tooltip": "Effect type from the token effect vocabulary"
            },
            "value": {
              "type": "number",
              "defaultValue": 0,
              "tooltip": "Effect value per stack. Meaning depends on type."
            },
            "damage_type": {
              "type": "chooseOne",
              "options": [
                "physical",
                "fire",
                "water",
                "air",
                "earth",
                "arcane",
                "poison",
                "light",
                "dark",
                "absolute"
              ],
              "show": {
                "type": [
                  "dot"
                ]
              },
              "tooltip": "Damage type for DoT effects."
            }
          }
        }
      },
      "uid": "2EJLZkokZopi"
    },
    {
      "uid": "aCstTabAB01",
      "id": "autocast_definitions",
      "name": "Autocast",
      "isArray": true,
      "schema": {
        "name": {
          "type": "string",
          "tooltip": "Display name for this autocast"
        },
        "source": {
          "type": "chooseOne",
          "fromFile": "character_stats",
          "tooltip": "Character stat that activates this autocast. Creature must have this stat > 0."
        },
        "stat_is_chance": {
          "type": "boolean",
          "tooltip": "If true, the source stat's value is used as trigger chance %. If false, autocast always triggers when stat > 0."
        },
        "trigger": {
          "type": "chooseOne",
          "options": [
            "battle_start",
            "turn_start",
            "on_attack",
            "on_kill",
            "on_damage_taken"
          ],
          "tooltip": "When this autocast fires."
        },
        "target": {
          "type": "chooseOne",
          "options": [
            "self",
            "all_allies",
            "random_ally",
            "lowest_hp_ally",
            "all_enemies",
            "random_enemy",
            "attacker",
            "attacker_target"
          ],
          "tooltip": "Who the autocast ability targets."
        },
        "ability": {
          "type": "schema[]",
          "tooltip": "Pool of abilities. One picked per trigger using weights. Single entry = always that one.",
          "objects": {
            "id": {
              "type": "chooseOne",
              "fromFile": "ability_templates",
              "fromFileTypeAnd": "{ \"meta.is_autocast\": true }",
              "tooltip": "Autocast ability template to cast."
            },
            "weight": {
              "type": "number",
              "tooltip": "Relative weight for random selection. Higher = more likely. Default: 1."
            }
          }
        }
      }
    }
  ],
