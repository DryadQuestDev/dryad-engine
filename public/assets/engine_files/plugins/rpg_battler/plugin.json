{
  "id": "rpg_battler",
  "name": "RPG Battler",
  "description": "Turn-based RPG battle system with player-controlled party combat",
  "author": "Nekon",
  "version": "1.0.0",
  "order": 0,
  "scripts": [
    "main.mjs"
  ],
  "editor_popups": [
    {
      "id": "rpg-overlay-tuner",
      "name": "Overlay Tuner",
      "tab": "character_templates",
      "script": "scripts/editor/OverlayTuner.mjs",
      "css": "scripts/editor/OverlayTuner.css"
    }
  ],
  "tabs": [
    {
      "id": "battle_config",
      "name": "Config",
      "schema": {
        "max_party_size": {
          "type": "number",
          "defaultValue": 4,
          "tooltip": "Maximum number of characters on the player side."
        }
      }
    },
    {
      "id": "battles",
      "name": "Battles",
      "isArray": true,
      "schema": {
        "id": {
          "type": "string",
          "required": true,
          "tooltip": "Unique battle identifier used to start this battle from scripts."
        },
        "name": {
          "type": "string",
          "tooltip": "Display name for this battle encounter."
        },
        "background": {
          "type": "chooseOne",
          "fromFile": "assets",
          "tooltip": "Background asset for the battle scene (from assets.json)."
        },
        "enemies": {
          "type": "schema[]",
          "tooltip": "Enemy composition for this battle.",
          "objects": {
            "character_id": {
              "type": "chooseOne",
              "fromFile": "character_templates",
              "required": true,
              "tooltip": "Character template or live character ID."
            },
            "is_live_instance": {
              "type": "boolean",
              "defaultValue": false,
              "tooltip": "If true, fetch the existing live character instead of creating a new instance from template."
            },
            "amount": {
              "type": "number",
              "defaultValue": 1,
              "tooltip": "Number of this enemy to spawn."
            }
          }
        }
      }
    },
    {
      "id": "token_definitions",
      "name": "Token Definitions",
      "isArray": true,
      "schema": {
        "id": {
          "type": "string",
          "required": true,
          "tooltip": "Unique token identifier (e.g. 'burn', 'shield', 'taunt')"
        },
        "source": {
          "type": "chooseOne",
          "fromFile": "character_stats",
          "tooltip": "Character stat that sets initial stacks at battle start. Empty = starts at 0."
        },
        "name": {
          "type": "string",
          "required": true,
          "tooltip": "Display name shown in UI"
        },
        "description": {
          "type": "htmlarea",
          "tooltip": "Description shown on hover in character viewer"
        },
        "icon": {
          "type": "file",
          "fileType": "image",
          "tooltip": "Icon displayed on character"
        },
        "color": {
          "type": "color",
          "tooltip": "Color for floating combat text (hex). Overrides default."
        },
        "max_stacks": {
          "type": "number",
          "defaultValue": 0,
          "tooltip": "Maximum stacks allowed. 0 = unlimited."
        },
        "polarity": {
          "type": "chooseOne",
          "options": [
            "positive",
            "negative",
            "neutral"
          ],
          "defaultValue": "neutral",
          "tooltip": "positive = buff (cleansable by enemies), negative = debuff (cleansable by allies), neutral = non-cleansable"
        },
        "power_scaling": {
          "type": "boolean",
          "tooltip": "When true, applied stacks scale with caster power: stacks = round(power × aspectStacks / 100). Use for damage/healing tokens. Leave false for gating tokens (preparation, combo)."
        },
        "effects": {
          "type": "schema[]",
          "tooltip": "Composable effects that define token behavior",
          "objects": {
            "type": {
              "type": "chooseOne",
              "required": true,
              "options": [
                "dot",
                "hot",
                "absorb",
                "death_defiance",
                "stun",
                "taunt",
                "thorns"
              ],
              "tooltip": "dot = damage over time, hot = heal over time, absorb = shield, stun = skip turn, death_defiance = survive lethal at 1 HP, taunt = force enemies to target this character, thorns = reflect % of incoming damage"
            },
            "value": {
              "type": "number",
              "defaultValue": 0,
              "tooltip": "Effect value per stack. For thorns: % of damage reflected."
            },
            "damage_type": {
              "type": "chooseOne",
              "options": [
                "physical",
                "fire",
                "water",
                "air",
                "earth",
                "arcane",
                "poison",
                "light",
                "dark",
                "absolute"
              ],
              "show": {
                "type": [
                  "dot"
                ]
              },
              "tooltip": "Damage type for DoT effects."
            }
          }
        }
      }
    }
  ],
  "data": {
    "game_settings": [
      {
        "id": "rpg_battle_speed",
        "type": "chooseOne",
        "default_value": "fast",
        "values": [
          "slow",
          "medium",
          "fast"
        ],
        "label": "Battle Animation Speed",
        "tooltip": "Controls the speed of battle animations and action delays.",
        "uid": "RpgBattleSpeed01"
      }
    ],
    "character_attributes": [
      {
        "id": "battle_state",
        "uid": "RpgBattleStateAttr",
        "values": [
          "idle",
          "idle_wounded",
          "attack",
          "cast",
          "hit",
          "death"
        ]
      }
    ],
    "character_traits": [
      {
        "id": "battle_overlay_x_offset",
        "type": "number",
        "tooltip": "Horizontal offset (%) for the battle overlay (health bar, tokens). Positive = right."
      },
      {
        "id": "battle_overlay_y_offset",
        "type": "number",
        "tooltip": "Vertical offset (%) for the battle overlay (health bar, tokens). Positive = down."
      }
    ],
    "ability_definitions": [
      {
        "id": "target",
        "role": "meta",
        "type": "chooseOne",
        "options": [
          "self",
          "ally",
          "self_and_ally",
          "all_allies",
          "enemy",
          "all_enemies",
          "any"
        ],
        "ingame_description": "Target: [v]",
        "description": "What this ability can target.",
        "order": -10
      },
      {
        "id": "preparation",
        "role": "meta",
        "type": "boolean",
        "ingame_description": "Requires Preparation",
        "description": "Requires 1 Preparation stack on caster. Consumed on cast."
      },
      {
        "id": "bonus_action",
        "role": "meta",
        "type": "boolean",
        "ingame_description": "Bonus Action",
        "order": -20,
        "description": "If true, using this ability does not end the turn. Limited to 1 bonus action per turn."
      },
      {
        "id": "caster_min_health",
        "role": "meta",
        "type": "number",
        "ingame_description": "Requires below [v]% HP",
        "description": "Caster must have LESS than X% HP (0-100) for ability to be usable."
      },
      {
        "id": "caster_max_health",
        "role": "meta",
        "type": "number",
        "ingame_description": "Requires above [v]% HP",
        "description": "Caster must have MORE than X% HP (0-100) for ability to be usable."
      },
      {
        "id": "target_min_health",
        "role": "meta",
        "type": "number",
        "ingame_description": "Target must be below [v]% HP",
        "description": "Target must have LESS than X% HP (0-100)."
      },
      {
        "id": "target_max_health",
        "role": "meta",
        "type": "number",
        "ingame_description": "Target must be above [v]% HP",
        "description": "Target must have MORE than X% HP (0-100)."
      },
      {
        "id": "base_weight",
        "role": "meta",
        "type": "number",
        "description": "AI priority weight. Higher values = AI prefers this ability."
      },
      {
        "id": "charges",
        "role": "meta",
        "type": "number",
        "ingame_description": "Charges: [v]",
        "description": "Max charges available. 0 = unlimited (cooldown only). Charges reset between battles."
      },
      {
        "id": "cd_on_battle_start",
        "role": "meta",
        "type": "number",
        "order": -96,
        "ingame_description": "Starts on cooldown: [v]",
        "description": "Initial cooldown applied at battle start."
      },
      {
        "id": "cd_group",
        "role": "meta",
        "type": "string",
        "order": -96,
        "description": "Shared cooldown group. When this ability is cast, all abilities with the same cd_group on this character also go on cooldown."
      },
      {
        "id": "chance",
        "role": "aspect",
        "type": "number",
        "ingame_description": "[v]% chance for the effect to take effect.",
        "description": "Probability (0-1) for the entire effect to occur. Undefined = 1.0 (always happens)."
      },
      {
        "id": "damage",
        "role": "aspect",
        "type": "number",
        "ingame_description": "Deal [v]% [damage_type] damage",
        "description": "Damage as % of caster's power (base-100: 120 = 120%)"
      },
      {
        "id": "damage_type",
        "role": "aspect",
        "type": "chooseOne",
        "options": [
          "physical",
          "fire",
          "water",
          "air",
          "earth",
          "arcane",
          "poison",
          "light",
          "dark",
          "absolute"
        ],
        "description": "Damage type. 'absolute' ignores resistances."
      },
      {
        "id": "healing",
        "role": "aspect",
        "type": "number",
        "ingame_description": "Heal [v]% HP",
        "description": "Healing as % of caster's power (base-100: 100 = 100%)"
      },
      {
        "id": "lifesteal",
        "role": "aspect",
        "type": "number",
        "ingame_description": "Steal [v]% of damage dealt as HP",
        "description": "Heals caster for this % of damage dealt (after defenses)."
      },
      {
        "id": "token_apply",
        "role": "aspect",
        "type": "chooseOne",
        "fromFile": "plugins_data/rpg_battler/token_definitions",
        "ingame_description": "Apply [token_stacks] [v] [token_duration]",
        "ingame_description_ref": "name",
        "description": "Token to apply to target(s). Stacks set by token_stacks."
      },
      {
        "id": "token_stacks",
        "role": "aspect",
        "type": "number",
        "description": "Stacks to apply. For power-scaled tokens: actual = power × value / 100."
      },
      {
        "id": "token_duration",
        "role": "aspect",
        "type": "number",
        "ingame_description": "for [v] turns",
        "ingame_hide": true,
        "description": "Duration in turns. Omit for permanent tokens (shield, preparation)."
      },
      {
        "id": "token_apply_self",
        "role": "aspect",
        "type": "chooseOne",
        "fromFile": "plugins_data/rpg_battler/token_definitions",
        "ingame_description": "Apply [token_stacks_self] [v] to self [token_duration_self]",
        "ingame_description_ref": "name",
        "description": "Token to apply to caster."
      },
      {
        "id": "token_stacks_self",
        "role": "aspect",
        "type": "number",
        "description": "Stacks to apply to self."
      },
      {
        "id": "token_duration_self",
        "role": "aspect",
        "type": "number",
        "ingame_description": "for [v] turns",
        "ingame_hide": true,
        "description": "Duration in turns for self-applied token."
      },
      {
        "id": "status_apply",
        "role": "aspect",
        "type": "chooseMany",
        "fromFile": "character_statuses",
        "ingame_description": "Apply [v] [status_duration]",
        "ingame_description_ref": "name",
        "description": "Status IDs to apply to target(s)"
      },
      {
        "id": "status_duration",
        "role": "aspect",
        "type": "number",
        "ingame_description": "for [v] turns",
        "ingame_hide": true,
        "description": "Duration in turns for applied statuses. Overrides the status template duration. Omit to use template default."
      },
      {
        "id": "status_apply_self",
        "role": "aspect",
        "type": "chooseMany",
        "fromFile": "character_statuses",
        "ingame_description": "Apply [v] to self [status_duration_self]",
        "ingame_description_ref": "name",
        "description": "Status IDs to apply to caster."
      },
      {
        "id": "status_duration_self",
        "role": "aspect",
        "type": "number",
        "ingame_description": "for [v] turns",
        "ingame_hide": true,
        "description": "Duration in turns for self-applied statuses. Overrides the status template duration. Omit to use template default."
      },
      {
        "id": "status_remove",
        "role": "aspect",
        "type": "chooseMany",
        "fromFile": "character_statuses",
        "ingame_description": "Remove [v]",
        "ingame_description_ref": "name",
        "description": "Status IDs to remove/cleanse from target"
      },
      {
        "id": "cooldown_change",
        "role": "aspect",
        "type": "number",
        "ingame_description": "Modify cooldowns by [v]",
        "description": "Modify ability cooldowns (signed). Positive = increase, negative = refresh."
      },
      {
        "id": "charges_change",
        "role": "aspect",
        "type": "number",
        "ingame_description": "Modify charges by [v]",
        "description": "Modify ability charges (signed). Positive = add, negative = reduce."
      },
      {
        "id": "combo",
        "role": "aspect",
        "type": "boolean",
        "ingame_description": "Requires Combo",
        "description": "Requires 1 Combo stack per target. Consumed per target hit."
      },
      {
        "id": "cleanse",
        "role": "aspect",
        "type": "boolean",
        "ingame_description": "Cleanse",
        "description": "Remove cleansable tokens. Ally: remove negative. Enemy: remove positive."
      },
      {
        "id": "splash",
        "role": "aspect",
        "type": "number",
        "ingame_description": "Hit up to [v] neighbors",
        "description": "Also hits up to N neighbors of the primary target. Works for both enemy and ally targets — neighbors are determined from the target's party."
      },
      {
        "id": "splash_only",
        "role": "aspect",
        "type": "boolean",
        "ingame_description": "Skip primary target",
        "description": "When true, the primary target is excluded from this effect — only splash neighbors are hit. Requires splash."
      }
    ],
